2714 attribute vec3 aLocal;
attribute vec2 aUV;
attribute float aShade;
attribute vec4 aTint;
attribute vec3 aNormal;
attribute float aWash;
attribute vec3 iCenter;
attribute vec3 iRight;
attribute vec3 iUp;
attribute vec3 iFwd;
attribute vec4 iColor;
attribute float iWash;
uniform mat3 uField;
uniform vec3 uPivot;
uniform vec3 uShift;
uniform vec4 uLens;
// x and y take the game's screen into the picture, z and w are where its top and left edges
// land: a whole screen puts them at one and minus one, a piece of one puts them further out.
uniform vec4 uScreen;
uniform vec2 uLayer;
uniform vec4 uLight;
uniform vec4 uLamp[4];
uniform vec4 uLampHue[4];
uniform vec3 uLightAt;
uniform float uHomo;
uniform float uRibbon;
uniform float nfTime;
uniform float nfBeat;
uniform vec2 nfSize;
varying vec2 vUV;
varying vec4 vColor;
varying float vDown;
varying vec3 vWorld;
varying vec3 vNormal;
varying vec3 vLocal;
varying float vWash;

vec3 nfWorld() {
    return iCenter + iRight * aLocal.x + iUp * aLocal.y + iFwd * aLocal.z;
}

vec3 nfNormal() {
    return iRight * aNormal.x + iUp * aNormal.y + iFwd * aNormal.z;
}

vec2 nfUV() {
    return aUV;
}

vec4 nfTint() {
    return vec4(iColor.rgb * aTint.rgb * aShade, iColor.a * aTint.a);
}

void nfPass(vec3 world) {
    // How far down its art this corner sits; a ribbon is taken as the middle so it fades with its note.
    vDown = uRibbon > 0.5 ? 0.5 : aLocal.y + 0.5;
    vUV = aUV;
    vWorld = world + uLightAt;
    vNormal = nfNormal();
    vLocal = aLocal;
    vColor = nfTint();
    vWash = 1.0 - (1.0 - iWash) * (1.0 - aWash);
}

vec2 nfScreenOf(vec3 world) {
    vec3 turned = uField * (world - uPivot) + uShift;
    float w = uLens.x / max(uLens.x - turned.z, 1.0);
    return vec2(uLens.y, uLens.z) + turned.xy * w;
}

vec4 nfProject(vec3 world) {
    vec3 turned = uField * (world - uPivot) + uShift;

    float raw = uLens.x - turned.z;
    float away = max(raw, 1.0);
    float w = uLens.x / away;

    vec2 screen = vec2(uLens.y, uLens.z) + turned.xy * w;

    float depth = clamp(-turned.z / uLens.w, -1.0, 1.0) * uLayer.y * 0.98 + uLayer.x;

    float flatX = screen.x * uScreen.x + uScreen.w;
    float flatY = screen.y * uScreen.y + uScreen.z;

    float far = raw / uLens.x;
    vec4 kept = vec4((uLens.y * uScreen.x + uScreen.w) * far + turned.x * uScreen.x,
                     (uLens.z * uScreen.y + uScreen.z) * far + turned.y * uScreen.y,
                     depth * far, far);

    return uHomo > 0.5 ? kept : vec4(flatX, flatY, depth, 1.0);
}

vec4 nfVertex() {
    vec3 world = nfWorld();
    nfPass(world);
    return nfProject(world);
}

